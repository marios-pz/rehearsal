{
  "name": "rehearsal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:bootstrap && node --env-file-if-exists=.env node_modules/.bin/vite dev",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env node_modules/.bin/vite preview",
    "start": "npm run db:bootstrap && node --env-file-if-exists=.env build/index.js",
    "db:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap.js",
    "db:generate": "node --env-file-if-exists=.env node_modules/.bin/drizzle-kit generate",
    "db:studio": "node --env-file-if-exists=.env node_modules/.bin/drizzle-kit studio",
    "send-reminders": "node --env-file-if-exists=.env scripts/send-reminders.js",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "postgres": "^3.4.5",
    "resend": "^6.25.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    },
    "cookie": "^0.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
